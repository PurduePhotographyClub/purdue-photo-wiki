---
import Pagination from 'virtual:starlight/components/Pagination';

const mainSite = 'https://purduephotoclub.org';
const listservActionUrl = 'https://lists.purdue.edu/scripts/wa.exe';
const listservManageUrl = 'https://lists.purdue.edu/scripts/wa.exe?SUBED1=PURDUEPHOTOCLUB&A=1';
const listservListName = 'PURDUEPHOTOCLUB';
const { prev, next } = Astro.locals.starlightRoute.pagination;

const socialLinks = [
  { href: 'https://www.instagram.com/purduephotoclub/', label: 'Instagram', icon: 'instagram' },
  { href: `${mainSite}/discord`, label: 'Discord', icon: 'discord' },
  { href: 'mailto:photo@purdue.edu', label: 'Email', icon: 'mail' },
  { href: 'https://linktr.ee/purduephotoclub', label: 'Linktree', icon: 'external' },
  { href: 'https://boilerlink.purdue.edu/organization/photoclub', label: 'BoilerLink', icon: 'external' },
];

const iconClass = 'size-3.5 fill-none stroke-current stroke-2 [stroke-linecap:round] [stroke-linejoin:round]';
---

{(prev || next) && (
  <div class="wiki-doc-pagination">
    <Pagination />
  </div>
)}

<footer class="ppc-footer">
  <div class="ppc-footer__inner">
    <div class="ppc-footer__grid">
      <div>
        <a href={mainSite} class="ppc-footer__brand">
          <img src="/images/brand/wiki/ppc-logo.webp" alt="" />
          <span>Purdue Photography Club</span>
        </a>
        <p class="ppc-footer__copy">
          Where analog tradition meets digital innovation. Capturing moments in silver halide and silicon since 1934.
        </p>
      </div>

      <div>
        <p class="ppc-footer__label">Connect With Us</p>
        <div class="ppc-footer__socials">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith('mailto:') ? undefined : '_blank'}
              rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
            >
              {link.icon === 'instagram' && (
                <svg viewBox="0 0 24 24" aria-hidden="true" class={iconClass}>
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <path d="M17.5 6.5h.01" />
                </svg>
              )}
              {link.icon === 'mail' && (
                <svg viewBox="0 0 24 24" aria-hidden="true" class={iconClass}>
                  <path d="M4 6h16v12H4z" />
                  <path d="m4 7 8 6 8-6" />
                </svg>
              )}
              {link.icon === 'external' && (
                <svg viewBox="0 0 24 24" aria-hidden="true" class={iconClass}>
                  <path d="M7 17 17 7" />
                  <path d="M8 7h9v9" />
                  <path d="M5 5v14h14" />
                </svg>
              )}
              {link.icon === 'discord' && (
                <svg viewBox="0 0 24 24" aria-hidden="true" class={iconClass}>
                  <path d="M9.09 9a3 3 0 0 1 5.83 0" />
                  <path d="M20.27 6.73a19.6 19.6 0 0 0-4.84-1.5 14.68 14.68 0 0 0-.64 1.31 18.16 18.16 0 0 0-5.57 0 14.68 14.68 0 0 0-.65-1.31 19.55 19.55 0 0 0-4.84 1.5A20.09 20.09 0 0 0 .29 18.07a19.72 19.72 0 0 0 6.03 3.05 14.82 14.82 0 0 0 1.3-2.1 12.74 12.74 0 0 1-2.05-.99l.49-.38a14.08 14.08 0 0 0 12 0l.49.38c-.66.39-1.35.72-2.06.99a14.82 14.82 0 0 0 1.3 2.1 19.65 19.65 0 0 0 6.02-3.05A20.06 20.06 0 0 0 20.27 6.73zM8.52 15.65a2.33 2.33 0 0 1-2.18-2.4 2.31 2.31 0 0 1 2.18-2.4 2.31 2.31 0 0 1 2.17 2.4 2.33 2.33 0 0 1-2.17 2.4zm6.96 0a2.33 2.33 0 0 1-2.17-2.4 2.31 2.31 0 0 1 2.17-2.4 2.31 2.31 0 0 1 2.18 2.4 2.33 2.33 0 0 1-2.18 2.4z" />
                </svg>
              )}
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <div class="ppc-footer__newsletter">
        <p class="ppc-footer__label">Newsletter</p>
        <form action={listservActionUrl} method="post" target="purdue-listserv-footer" class="ppc-footer__form">
          <input type="hidden" name="SUBED2" value={listservListName} />
          <input type="hidden" name="A" value="1" />
          <input type="hidden" name="L" value={listservListName} />
          <input type="text" name="p" placeholder="Your name" required />
          <input type="hidden" name="q" value="" />
          <input type="email" name="s" placeholder="your@email.com" required />
          <input type="hidden" name="t" value="" />
          <input type="hidden" name="_charset_" value="UTF-8" />
          <button type="submit" name="b" value="Subscribe">Subscribe</button>
        </form>
        <iframe name="purdue-listserv-footer" title="Purdue LISTSERV footer signup" hidden></iframe>
        <p class="ppc-footer__small">
          Want to unsubscribe?
          <a href={listservManageUrl} target="_blank" rel="noopener noreferrer">Open Purdue LISTSERV</a>.
        </p>
      </div>
    </div>

    <div class="ppc-footer__bottom">
      <p>Est. 1934 · Purdue Photography Club · West Lafayette, IN</p>
      <p>
        Made with love by
        <a href="https://alesgsanudoo.com" target="_blank" rel="noopener noreferrer">Alejandro Griffith</a>
        · © 2026
      </p>
    </div>
  </div>
</footer>

<style>
  .wiki-doc-pagination {
    box-sizing: border-box;
    width: min(68rem, calc(100vw - 2rem));
    max-width: 100%;
    margin: clamp(2rem, 5vw, 4rem) auto clamp(2rem, 5vw, 3rem);
  }

  @media (max-width: 50rem) {
    .wiki-doc-pagination {
      width: 100%;
      margin-inline: 0;
    }
  }
</style>

<script is:inline>
  (() => {
    const images = Array.from(
      document.querySelectorAll('.basics-page figure img, .anatomy-page figure img, .editing-page figure img, .gear-page figure img')
    );

    if (images.length === 0) return;

    let lastFocusedElement = null;
    let viewer = document.querySelector('.wiki-image-viewer');

    if (!viewer) {
      viewer = document.createElement('div');
      viewer.className = 'wiki-image-viewer';
      viewer.hidden = true;
      viewer.setAttribute('role', 'dialog');
      viewer.setAttribute('aria-modal', 'true');
      viewer.setAttribute('aria-label', 'Image viewer');

      const backdrop = document.createElement('button');
      backdrop.className = 'wiki-image-viewer__backdrop';
      backdrop.type = 'button';
      backdrop.setAttribute('aria-label', 'Close image viewer');

      const figure = document.createElement('figure');
      const viewerImage = document.createElement('img');
      viewerImage.alt = '';
      const caption = document.createElement('figcaption');
      figure.append(viewerImage, caption);

      const closeButton = document.createElement('button');
      closeButton.className = 'wiki-image-viewer__close';
      closeButton.type = 'button';
      closeButton.setAttribute('aria-label', 'Close image viewer');
      closeButton.innerHTML = '&times;';

      viewer.append(backdrop, figure, closeButton);
      document.body.append(viewer);
    }

    const viewerImage = viewer.querySelector('img');
    const caption = viewer.querySelector('figcaption');
    const closeButton = viewer.querySelector('.wiki-image-viewer__close');
    const closeTargets = viewer.querySelectorAll('.wiki-image-viewer__backdrop, .wiki-image-viewer__close');

    const updateViewerHeight = () => {
      const height = window.visualViewport?.height || window.innerHeight;
      document.documentElement.style.setProperty('--wiki-viewer-height', `${height}px`);
    };

    const getCaptionText = (image) => {
      const figure = image.closest('figure');
      const figureCaption = figure?.querySelector('figcaption');
      return figureCaption?.innerText?.trim() || image.alt || 'Expanded image';
    };

    const closeViewer = () => {
      if (viewer.hidden) return;

      viewer.hidden = true;
      document.body.classList.remove('wiki-image-viewer-open');
      viewerImage.removeAttribute('src');
      caption.textContent = '';
      document.documentElement.style.removeProperty('--wiki-viewer-height');

      if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
        lastFocusedElement.focus({ preventScroll: true });
      }
    };

    const openViewer = (image) => {
      lastFocusedElement = document.activeElement;
      updateViewerHeight();
      viewerImage.src = image.currentSrc || image.src;
      viewerImage.alt = image.alt || '';
      caption.textContent = getCaptionText(image);
      viewer.hidden = false;
      document.body.classList.add('wiki-image-viewer-open');
      closeButton.focus({ preventScroll: true });
    };

    closeTargets.forEach((target) => {
      target.addEventListener('click', closeViewer);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeViewer();
    });

    window.visualViewport?.addEventListener('resize', updateViewerHeight);
    window.visualViewport?.addEventListener('scroll', updateViewerHeight);
    window.addEventListener('resize', updateViewerHeight);

    images.forEach((image) => {
      if (image.dataset.wikiExpandableImage === 'true') return;

      image.dataset.wikiExpandableImage = 'true';
      image.classList.add('wiki-expandable-image');
      image.tabIndex = 0;
      image.setAttribute('role', 'button');
      image.setAttribute('aria-label', `View ${getCaptionText(image)} full size`);

      image.addEventListener('click', () => openViewer(image));
      image.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        openViewer(image);
      });
    });
  })();
</script>
