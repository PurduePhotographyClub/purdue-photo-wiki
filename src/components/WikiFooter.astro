---
import Pagination from 'virtual:starlight/components/Pagination';

const mainSite = 'https://purduephotoclub.org';
const listservActionUrl = 'https://lists.purdue.edu/scripts/wa.exe';
const listservManageUrl = 'https://lists.purdue.edu/scripts/wa.exe?SUBED1=PURDUEPHOTOCLUB&A=1';
const listservListName = 'PURDUEPHOTOCLUB';
const { prev, next } = Astro.locals.starlightRoute.pagination;

const socialLinks = [
  { href: 'https://www.instagram.com/purduephotoclub/', label: 'Instagram' },
  { href: `${mainSite}/discord`, label: 'Discord' },
  { href: 'mailto:photo@purdue.edu', label: 'Email' },
  { href: 'https://linktr.ee/purduephotoclub', label: 'Linktree' },
  { href: 'https://boilerlink.purdue.edu/organization/photoclub', label: 'BoilerLink' },
];
---

{(prev || next) && (
  <div class="mt-14">
    <Pagination />
  </div>
)}

<footer class="mt-16 border-t border-white/10 pt-10 pb-6">
  <div class="grid gap-10 lg:grid-cols-[1fr_0.7fr_1.2fr]">
    <div>
      <a href={mainSite} class="inline-flex min-h-11 items-center gap-3 text-white no-underline">
        <img src="/images/brand/wiki/ppc-logo.webp" width="96" height="96" alt="" class="size-10 rounded-full brightness-[1.7] invert mix-blend-screen" />
        <span class="font-['Playfair_Display',Georgia,serif] text-lg font-bold">Purdue Photography Club</span>
      </a>
      <p class="mt-4 max-w-md text-sm leading-7 text-neutral-400">
        Where analog tradition meets digital innovation. Capturing moments in silver halide and silicon since 1934.
      </p>
    </div>

    <div>
      <p class="mb-3 text-[0.62rem] font-bold tracking-[0.18em] text-neutral-300 uppercase">Connect with us</p>
      <nav class="grid" aria-label="Club social links">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('mailto:') ? undefined : '_blank'}
            rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
            class="inline-flex min-h-11 items-center border-b border-white/10 text-xs text-neutral-400 no-underline transition hover:border-white/25 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200"
          >
            {link.label}
            <span aria-hidden="true" class="ml-auto text-neutral-600">↗</span>
          </a>
        ))}
      </nav>
    </div>

    <div>
      <p class="mb-3 text-[0.62rem] font-bold tracking-[0.18em] text-neutral-300 uppercase">Newsletter</p>
      <form data-wiki-newsletter-form action={listservActionUrl} method="post" target="purdue-listserv-footer" class="grid gap-2 sm:grid-cols-[1fr_1.25fr_auto]">
        <input type="hidden" name="SUBED2" value={listservListName} />
        <input type="hidden" name="A" value="1" />
        <input type="hidden" name="L" value={listservListName} />
        <label class="sr-only" for="wiki-footer-name">Your name</label>
        <input
          id="wiki-footer-name"
          type="text"
          name="p"
          autocomplete="name"
          placeholder="Your name"
          required
          class="min-h-11 min-w-0 rounded-none border border-white/15 bg-white/[0.03] px-3 text-sm text-white placeholder:text-neutral-500 focus:border-amber-200/60 focus:outline-none"
        />
        <input type="hidden" name="q" value="" />
        <label class="sr-only" for="wiki-footer-email">Email address</label>
        <input
          id="wiki-footer-email"
          type="email"
          name="s"
          autocomplete="email"
          placeholder="your@email.com"
          required
          class="min-h-11 min-w-0 rounded-none border border-white/15 bg-white/[0.03] px-3 text-sm text-white placeholder:text-neutral-500 focus:border-amber-200/60 focus:outline-none"
        />
        <input type="hidden" name="t" value="" />
        <input type="hidden" name="_charset_" value="UTF-8" />
        <button data-wiki-newsletter-submit type="submit" name="b" value="Subscribe" class="min-h-11 border border-white bg-white px-5 text-[0.65rem] font-bold tracking-[0.14em] text-black uppercase transition hover:bg-neutral-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200 disabled:cursor-wait disabled:opacity-60">
          Subscribe
        </button>
      </form>
      <iframe data-wiki-newsletter-frame name="purdue-listserv-footer" title="Purdue LISTSERV footer signup" hidden></iframe>
      <p data-wiki-newsletter-status role="status" aria-live="polite" class="mt-3 hidden text-xs leading-5 text-amber-100"></p>
      <p class="mt-3 text-xs leading-5 text-neutral-400">
        Want to unsubscribe?
        <a href={listservManageUrl} target="_blank" rel="noopener noreferrer" class="text-neutral-200 underline decoration-white/30 underline-offset-4">Open Purdue LISTSERV</a>.
      </p>
    </div>
  </div>

  <div class="mt-10 flex flex-col gap-2 border-t border-white/10 pt-5 text-[0.62rem] leading-5 text-neutral-400 sm:flex-row sm:items-center sm:justify-between">
    <p>Est. 1934 · Purdue Photography Club · West Lafayette, IN</p>
    <p>
      Made with love by
      <a href="https://alesgsanudoo.com" target="_blank" rel="noopener noreferrer" class="text-neutral-200 underline decoration-white/30 underline-offset-4">Alejandro Griffith</a>
      · © 2026
    </p>
  </div>
</footer>

<script>
  const newsletterForm = document.querySelector<HTMLFormElement>('[data-wiki-newsletter-form]');
  const newsletterFrame = document.querySelector<HTMLIFrameElement>('[data-wiki-newsletter-frame]');
  const newsletterStatus = document.querySelector<HTMLElement>('[data-wiki-newsletter-status]');
  const newsletterSubmit = document.querySelector<HTMLButtonElement>('[data-wiki-newsletter-submit]');
  let newsletterSubmitted = false;

  newsletterForm?.addEventListener('submit', () => {
    newsletterSubmitted = true;
    if (newsletterStatus) {
      newsletterStatus.textContent = 'Sending your request to Purdue LISTSERV…';
      newsletterStatus.classList.remove('hidden');
    }
    if (newsletterSubmit) {
      newsletterSubmit.disabled = true;
      newsletterSubmit.textContent = 'Sending…';
    }
  });

  newsletterFrame?.addEventListener('load', () => {
    if (!newsletterSubmitted) return;
    newsletterSubmitted = false;
    newsletterForm?.reset();
    if (newsletterStatus) {
      newsletterStatus.textContent = 'Request sent. Check your inbox for Purdue LISTSERV confirmation.';
    }
    if (newsletterSubmit) {
      newsletterSubmit.disabled = false;
      newsletterSubmit.textContent = 'Subscribe';
    }
  });
</script>
