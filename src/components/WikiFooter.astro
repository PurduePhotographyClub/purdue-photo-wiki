---
import Pagination from 'virtual:starlight/components/Pagination';

const mainSite = 'https://purduephotoclub.org';
const { prev, next } = Astro.locals.starlightRoute.pagination;

const navLinks = [
  { href: `${mainSite}/gallery`, label: 'Gallery' },
  { href: `${mainSite}/members`, label: 'Members' },
  { href: `${mainSite}/competitions`, label: 'Competitions' },
  { href: `${mainSite}/facilities`, label: 'Facilities' },
  { href: `${mainSite}/membership`, label: 'Membership' },
  { href: `${mainSite}/events`, label: 'Events' },
  { href: `${mainSite}/request`, label: 'Request' },
];

const socialLinks = [
  { href: 'https://www.instagram.com/purduephotoclub/', label: 'Instagram', icon: 'instagram', external: true },
  { href: `${mainSite}/discord`, label: 'Discord', icon: 'discord', external: false },
  { href: 'mailto:photo@purdue.edu', label: 'Email', icon: 'email', external: false },
  { href: 'https://linktr.ee/purduephotoclub', label: 'Linktree', icon: 'external', external: true },
  { href: 'https://boilerlink.purdue.edu/organization/photoclub', label: 'BoilerLink', icon: 'external', external: true },
];

const footerLinkClasses = 'inline-flex min-h-11 items-center text-sm tracking-wide text-neutral-500 no-underline transition-colors hover:text-white focus-visible:text-white focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-neutral-400 md:min-h-0';
---

{(prev || next) && (
  <div class="mx-auto! w-full max-w-6xl px-4 py-12 sm:px-7 sm:py-16 lg:px-10 xl:px-12">
    <Pagination />
  </div>
)}

<footer class="relative left-1/2 w-screen -ml-[50vw]! border-t border-neutral-800 bg-neutral-950 px-5 py-10 sm:px-7 sm:py-12 lg:ml-[calc(-50vw-8.5rem)]! lg:px-10 xl:px-12">
  <div class="lg:pl-[17rem]">
    <div class="mx-auto! w-full max-w-6xl">
      <div class="mb-9 grid grid-cols-1 gap-9 md:grid-cols-[1.15fr_1fr_0.8fr] md:gap-10">
      <div>
        <a href={mainSite} class="inline-flex min-h-11 items-center gap-3 text-white no-underline focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-neutral-400">
          <img src="/images/brand/wiki/ppc-logo.webp" width="96" height="96" alt="" class="wiki-brand-logo size-10 object-contain" />
          <span class="font-['Playfair_Display',Georgia,serif] text-xs tracking-[0.3em] text-neutral-400 uppercase">
            Purdue Photography Club
          </span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-6 tracking-wide text-neutral-500">
          Film, digital, darkroom, and club work at Purdue since 1934.
        </p>
      </div>

      <div>
        <p class="mb-4 font-mono text-[0.7rem] tracking-[0.26em] text-neutral-400 uppercase">Club links</p>
        <nav class="grid grid-cols-2 gap-2" aria-label="Club website links">
          {navLinks.map((link) => (
            <a href={link.href} class={footerLinkClasses}>{link.label}</a>
          ))}
        </nav>
      </div>

      <div>
        <p class="mb-4 font-mono text-[0.7rem] tracking-[0.26em] text-neutral-400 uppercase">Connect</p>
        <nav class="flex flex-col gap-1" aria-label="Club social links">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class:list={[footerLinkClasses, 'gap-2.5']}
            >
              {link.icon === 'instagram' && (
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0">
                  <rect width="18" height="18" x="3" y="3" rx="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <path d="M17.5 6.5h.01"></path>
                </svg>
              )}
              {link.icon === 'discord' && (
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0">
                  <path d="M9.09 9a3 3 0 0 1 5.83 0"></path>
                  <path d="M20.27 6.73a19.6 19.6 0 0 0-4.84-1.5 14.68 14.68 0 0 0-.64 1.31 18.16 18.16 0 0 0-5.57 0 14.68 14.68 0 0 0-.65-1.31 19.55 19.55 0 0 0-4.84 1.5A20.09 20.09 0 0 0 .29 18.07a19.72 19.72 0 0 0 6.03 3.05 14.82 14.82 0 0 0 1.3-2.1 12.74 12.74 0 0 1-2.05-.99l.49-.38a14.08 14.08 0 0 0 12 0l.49.38c-.66.39-1.35.72-2.06.99a14.82 14.82 0 0 0 1.3 2.1 19.65 19.65 0 0 0 6.02-3.05A20.06 20.06 0 0 0 20.27 6.73z"></path>
                </svg>
              )}
              {link.icon === 'email' && (
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0">
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-10 6L2 7"></path>
                </svg>
              )}
              {link.icon === 'external' && (
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0">
                  <path d="M15 3h6v6"></path>
                  <path d="M10 14 21 3"></path>
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                </svg>
              )}
              {link.label}
            </a>
          ))}
        </nav>
      </div>
      </div>

      <div class="flex flex-col items-center gap-4 border-t border-neutral-800 pt-6 text-center text-xs leading-5 tracking-wide text-neutral-500 md:flex-row md:justify-between md:text-left">
        <p>Est. 1934 · Purdue Photography Club · West Lafayette, IN</p>
        <p>
          Made with love by
          <a href="https://www.instagram.com/alesgs.photos/" target="_blank" rel="noopener noreferrer" class="text-neutral-300 underline decoration-white/30 underline-offset-4 transition-colors hover:text-white focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-neutral-400">Alejandro Griffith</a>
          · © 2026
        </p>
      </div>
    </div>
  </div>
</footer>
