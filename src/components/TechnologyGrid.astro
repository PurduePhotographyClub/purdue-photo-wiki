---
const technologies = [
  { name: 'Astro', detail: 'Builds the website shell and the static wiki', icon: 'astro', group: 'Interface' },
  { name: 'React', detail: 'Runs interactive parts of the public site and dashboard', icon: 'react', group: 'Interface' },
  { name: 'TypeScript', detail: 'Provides one language for every Worker and web app', icon: 'typescript', group: 'Foundation' },
  { name: 'Tailwind CSS', detail: 'Styles the pages and their responsive layouts', icon: 'tailwindcss', group: 'Interface' },
  { name: 'Starlight + Pagefind', detail: 'Organizes the wiki and builds its search index', icon: 'astro', group: 'Interface' },
  { name: 'Cloudflare Workers', detail: 'Runs the website, API, Discord, email, and scheduler services', icon: 'cloudflareworkers', group: 'Cloudflare' },
  { name: 'Cloudflare Pages', detail: 'Hosts and deploys this static wiki', icon: 'cloudflarepages', group: 'Cloudflare' },
  { name: 'D1', detail: 'Stores the club records used by the API', icon: 'cloudflare', group: 'Cloudflare' },
  { name: 'R2', detail: 'Stores gallery, competition, avatar, merchandise, and leadership media', icon: 'cloudflare', group: 'Cloudflare' },
  { name: 'KV', detail: 'Tracks receipt intake, leases, and retries', icon: 'cloudflare', group: 'Cloudflare' },
  { name: 'Email Routing', detail: 'Sends TooCOOL receipts to the Email Worker', icon: 'cloudflare', group: 'Cloudflare' },
  { name: 'Wrangler', detail: 'Builds and deploys Workers, and manages bindings, migrations, and secrets', icon: 'cloudflareworkers', group: 'Operations' },
  { name: 'Better Auth', detail: 'Manages sessions, accounts, passkeys, 2FA, and Discord links', icon: 'betterauth', group: 'Identity' },
  { name: 'Turnstile', detail: 'Checks for bots on public account and request forms', icon: 'cloudflare', group: 'Identity' },
  { name: 'Drizzle ORM', detail: 'Provides typed database access in the API Worker', icon: 'drizzle', group: 'Data' },
  { name: 'Discord', detail: 'Provides commands, roles, DMs, channels, and server events', icon: 'discord', group: 'Automation' },
  { name: 'discord.js', detail: 'Keeps the Discord Gateway connection open on the VPS', icon: 'discorddotjs', group: 'Automation' },
  { name: 'Node.js', detail: 'Runs the VPS Gateway and local development tools', icon: 'nodedotjs', group: 'Foundation' },
  { name: 'postal-mime + unpdf', detail: 'Reads email messages and extracts text from receipt PDFs', icon: 'package-library', group: 'Data' },
  { name: 'Resend', detail: 'Sends membership and activation emails', icon: 'resend', group: 'Communication' },
  { name: 'GitHub Actions', detail: 'Runs checks and deploys services to Cloudflare', icon: 'githubactions', group: 'Operations' },
];
---

<section aria-labelledby="technology-grid-title" class="my-10 border border-white/10 bg-white/10">
  <div class="flex flex-col gap-2 border-b border-white/10 bg-neutral-950 p-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="m-0 text-[0.6rem] tracking-[0.2em] text-amber-200 uppercase">Technology</p>
      <h2 id="technology-grid-title" class="mt-2! border-0! pt-0! text-3xl!">Tools used by the platform</h2>
    </div>
    <p class="m-0 max-w-md text-xs leading-5 text-neutral-400">Each service has a small, specific job.</p>
  </div>
  <div class="grid gap-px sm:grid-cols-2 xl:grid-cols-3">
    {technologies.map((technology) => (
      <article class="group flex min-h-36 gap-4 bg-neutral-950 p-5 transition hover:bg-neutral-900/80">
        <span class="grid size-12 shrink-0 place-items-center border border-white/10 bg-white/[0.025] transition group-hover:border-white/25">
          <img src={`/images/tech/${technology.icon}.svg`} width="26" height="26" alt="" loading="lazy" decoding="async" class="size-6 object-contain" />
        </span>
        <div>
          <p class="m-0 text-[0.55rem] tracking-[0.16em] text-neutral-500 uppercase">{technology.group}</p>
          <h3 class="mt-1! font-['Playfair_Display',Georgia,serif] text-xl! font-semibold text-white">{technology.name}</h3>
          <p class="mt-2 mb-0 text-xs leading-5 text-neutral-400">{technology.detail}</p>
        </div>
      </article>
    ))}
  </div>
</section>
