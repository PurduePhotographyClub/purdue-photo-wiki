---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const socialLinks = [
  { href: 'https://www.instagram.com/purduephotoclub/', label: 'Instagram', icon: 'instagram' },
  { href: 'https://purduephotoclub.org/discord', label: 'Discord', icon: 'discord' },
];

const iconClass = 'size-4 fill-none stroke-current stroke-2 [stroke-linecap:round] [stroke-linejoin:round]';
---

<div class="flex h-full w-full items-center gap-2 sm:gap-4 lg:grid lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-0">
  <a href="/" class="group flex min-w-0 shrink-0 items-center gap-2.5 text-white no-underline lg:h-full lg:px-7" aria-label="PPC Wiki home">
    <span class="grid size-10 shrink-0 place-items-center rounded-full border border-white/15 bg-white/[0.03] transition group-hover:border-amber-200/50">
      <img src="/images/brand/wiki/ppc-logo.webp" width="96" height="96" alt="" class="size-7 object-contain brightness-[1.7] invert mix-blend-screen" />
    </span>
    <span class="hidden min-w-0 sm:block">
      <span class="block font-['Playfair_Display',Georgia,serif] text-base leading-none font-bold tracking-wide text-neutral-100">PPC Wiki</span>
      <span class="mt-1 block text-[0.55rem] leading-none tracking-[0.2em] text-neutral-400 uppercase">Photo club field notes</span>
    </span>
  </a>

  <div class="ml-auto flex min-w-0 flex-1 items-center justify-end gap-2 sm:gap-4 lg:ml-0 lg:w-full lg:justify-start lg:gap-6 lg:px-8 xl:px-10">
    {shouldRenderSearch && (
      <div class="flex min-w-0 flex-1 justify-end sm:max-w-xs lg:max-w-lg lg:justify-start xl:max-w-2xl [&_button[data-open-modal]]:min-h-11 [&_button[data-open-modal]]:w-11 [&_button[data-open-modal]]:justify-center [&_button[data-open-modal]]:rounded-none [&_button[data-open-modal]]:border [&_button[data-open-modal]]:border-white/15 [&_button[data-open-modal]]:bg-white/[0.03] [&_button[data-open-modal]]:transition [&_button[data-open-modal]]:hover:border-white/35 sm:[&_button[data-open-modal]]:w-full sm:[&_button[data-open-modal]]:justify-start">
        <Search />
      </div>
    )}

    <nav class="hidden items-center gap-1 lg:ml-auto! lg:flex" aria-label="Club links">
      <a
        href="https://purduephotoclub.org"
        class="inline-flex min-h-11 items-center border border-transparent px-3 text-[0.65rem] tracking-[0.16em] text-neutral-300 uppercase transition hover:border-white/15 hover:text-white"
      >
        Club site
      </a>
      {socialLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.label}
          title={link.label}
          class="inline-flex size-11 items-center justify-center text-neutral-400 transition hover:bg-white/[0.04] hover:text-white"
        >
          {link.icon === 'instagram' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class={iconClass}>
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <path d="M17.5 6.5h.01" />
            </svg>
          )}
          {link.icon === 'discord' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class={iconClass}>
              <path d="M8.5 8.6a10.8 10.8 0 0 1 7 0M9 15c2 1.2 4 1.2 6 0" />
              <path d="M7.2 5.7A18 18 0 0 0 3.5 18c2.2 1.6 4.2 2.2 4.2 2.2l1-1.5M16.8 5.7A18 18 0 0 1 20.5 18c-2.2 1.6-4.2 2.2-4.2 2.2l-1-1.5" />
              <circle cx="9" cy="12" r="1" fill="currentColor" stroke="none" />
              <circle cx="15" cy="12" r="1" fill="currentColor" stroke="none" />
            </svg>
          )}
        </a>
      ))}
    </nav>

    <button
      type="button"
      data-wiki-menu
      aria-controls="starlight__sidebar"
      aria-expanded="false"
      aria-label="Open wiki navigation"
      class="inline-flex min-h-11 min-w-11 items-center justify-center border border-white/15 bg-white/[0.03] text-neutral-200 transition hover:border-white/35 hover:bg-white/[0.07] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200 lg:hidden"
    >
      <svg data-menu-open-icon viewBox="0 0 24 24" aria-hidden="true" class="size-5 fill-none stroke-current stroke-2">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg data-menu-close-icon viewBox="0 0 24 24" aria-hidden="true" class="hidden size-5 fill-none stroke-current stroke-2">
        <path d="m6 6 12 12M18 6 6 18" />
      </svg>
    </button>
  </div>
</div>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('[data-wiki-menu]');
  const sidebar = document.querySelector<HTMLElement>('#starlight__sidebar');
  const backdrop = sidebar?.querySelector<HTMLButtonElement>('[data-wiki-sidebar-backdrop]');
  const openIcon = menuButton?.querySelector<HTMLElement>('[data-menu-open-icon]');
  const closeIcon = menuButton?.querySelector<HTMLElement>('[data-menu-close-icon]');
  let returnFocus: HTMLElement | null = null;

  function focusableSidebarElements() {
    if (!sidebar) return [];
    return Array.from(
      sidebar.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), summary, [tabindex]:not([tabindex="-1"])')
    ).filter((element) => element.tabIndex >= 0 && !element.hasAttribute('hidden'));
  }

  function setSidebarOpen(isOpen: boolean, restoreFocus = true) {
    if (!menuButton || !sidebar) return;
    const pageMain = document.querySelector<HTMLElement>('main');

    menuButton.setAttribute('aria-expanded', String(isOpen));
    menuButton.setAttribute('aria-label', isOpen ? 'Close wiki navigation' : 'Open wiki navigation');
    sidebar.classList.toggle('hidden', !isOpen);
    document.body.classList.toggle('overflow-hidden', isOpen);
    openIcon?.classList.toggle('hidden', isOpen);
    closeIcon?.classList.toggle('hidden', !isOpen);

    if (pageMain) pageMain.inert = isOpen;

    if (isOpen) {
      returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : menuButton;
      requestAnimationFrame(() => focusableSidebarElements()[0]?.focus());
    } else if (restoreFocus) {
      returnFocus?.focus();
      returnFocus = null;
    }
  }

  menuButton?.addEventListener('click', () => {
    setSidebarOpen(menuButton.getAttribute('aria-expanded') !== 'true');
  });

  backdrop?.addEventListener('click', () => setSidebarOpen(false));

  sidebar?.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('a[href]')) return;
    if (window.matchMedia('(min-width: 64rem)').matches) return;
    setSidebarOpen(false, false);
  });

  sidebar?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      event.preventDefault();
      setSidebarOpen(false);
      return;
    }

    if (event.key !== 'Tab' || window.matchMedia('(min-width: 64rem)').matches) return;
    const focusable = focusableSidebarElements();
    const first = focusable[0];
    const last = focusable.at(-1);
    if (!first || !last) return;

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  window.addEventListener('resize', () => {
    if (!window.matchMedia('(min-width: 64rem)').matches) return;
    setSidebarOpen(false, false);
    returnFocus = null;
  });
</script>
