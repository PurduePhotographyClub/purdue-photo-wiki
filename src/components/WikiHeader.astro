---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';

const mainSite = '/';
const socialLinks = [
  {
    href: 'https://www.instagram.com/purduephotoclub/',
    label: 'Instagram',
    icon: 'instagram',
  },
  {
    href: `https://purduephotoclub.org/discord`,
    label: 'Discord',
    icon: 'discord',
  },
  {
    href: 'mailto:photo@purdue.edu',
    label: 'Email',
    icon: 'mail',
  },
];

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const socialLinkClass = 'inline-flex text-[#6b6660] transition-colors hover:text-ppc-paper';
const iconClass = 'size-4 fill-none stroke-current stroke-2 [stroke-linecap:round] [stroke-linejoin:round]';
---

<div class="grid h-full w-full grid-cols-[minmax(0,1fr)_auto] items-center gap-4 max-[50rem]:grid-cols-1">
  <a href={mainSite} class="group/wiki-nav inline-flex min-w-0 items-center gap-3 text-ppc-paper no-underline" aria-label="Purdue Photography Club home">
    <img src="/images/brand/wiki/ppc-logo.webp" alt="" class="size-10 shrink-0 rounded-full brightness-[1.7] invert mix-blend-screen max-[50rem]:size-9" />
    <span class="inline-flex min-w-0 items-center gap-3 max-[50rem]:max-w-[calc(100vw-8rem)] max-[50rem]:gap-2">
      <span class="font-display max-w-full overflow-hidden text-xs leading-tight text-[#d5d0c8] uppercase text-ellipsis whitespace-nowrap max-[50rem]:text-[0.64rem] max-[24rem]:max-w-32 max-[24rem]:text-[0.56rem]">Purdue Photography Club</span>
      <span class="relative ml-[-0.1rem] inline-flex cursor-pointer items-baseline transition-transform duration-200 group-hover/wiki-nav:-translate-y-px" aria-label="Wiki">
        <span class="inline-block bg-ppc-paper px-2 py-1 text-[0.68rem] leading-none font-bold text-ppc-ink uppercase shadow-[0_0_12px_rgb(246_241_232_/_0.15),0_1px_3px_rgb(0_0_0_/_0.3)] transition duration-200 [transform:rotate(-6deg)_translateY(-0.25rem)] [-webkit-text-fill-color:var(--color-ppc-ink)] group-hover/wiki-nav:scale-105 group-hover/wiki-nav:shadow-[0_0_20px_rgb(246_241_232_/_0.25),0_2px_6px_rgb(0_0_0_/_0.3)] max-[50rem]:text-[0.56rem]" style="animation: wiki-badge-shimmer 3s ease-in-out infinite;">wiki</span>
      </span>
    </span>
  </a>

  <div class="flex min-w-0 items-center justify-end gap-4 max-[50rem]:hidden">
    <div class="w-[min(32vw,20rem)] min-w-36 max-[64rem]:w-[min(38vw,16rem)]">
      {shouldRenderSearch && <Search />}
    </div>
    <div class="flex items-center gap-3 border-l border-white/10 pl-4" aria-label="Social links">
      {socialLinks.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith('mailto:') ? undefined : '_blank'}
          rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
          aria-label={link.label}
          title={link.label}
          class={socialLinkClass}
        >
          {link.icon === 'instagram' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class={iconClass}>
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <path d="M17.5 6.5h.01" />
            </svg>
          )}
          {link.icon === 'mail' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class={iconClass}>
              <path d="M4 6h16v12H4z" />
              <path d="m4 7 8 6 8-6" />
            </svg>
          )}
          {link.icon === 'discord' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class={iconClass}>
              <path d="M9.09 9a3 3 0 0 1 5.83 0" />
              <path d="M20.27 6.73a19.6 19.6 0 0 0-4.84-1.5 14.68 14.68 0 0 0-.64 1.31 18.16 18.16 0 0 0-5.57 0 14.68 14.68 0 0 0-.65-1.31 19.55 19.55 0 0 0-4.84 1.5A20.09 20.09 0 0 0 .29 18.07a19.72 19.72 0 0 0 6.03 3.05 14.82 14.82 0 0 0 1.3-2.1 12.74 12.74 0 0 1-2.05-.99l.49-.38a14.08 14.08 0 0 0 12 0l.49.38c-.66.39-1.35.72-2.06.99a14.82 14.82 0 0 0 1.3 2.1 19.65 19.65 0 0 0 6.02-3.05A20.06 20.06 0 0 0 20.27 6.73zM8.52 15.65a2.33 2.33 0 0 1-2.18-2.4 2.31 2.31 0 0 1 2.18-2.4 2.31 2.31 0 0 1 2.17 2.4 2.33 2.33 0 0 1-2.17 2.4zm6.96 0a2.33 2.33 0 0 1-2.17-2.4 2.31 2.31 0 0 1 2.17-2.4 2.31 2.31 0 0 1 2.18 2.4 2.33 2.33 0 0 1-2.18 2.4z" />
            </svg>
          )}
        </a>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const updateMobileHeaderState = () => {
      root.classList.toggle('wiki-mobile-header-scrolled', window.scrollY > 8);
    };

    updateMobileHeaderState();
    window.addEventListener('scroll', updateMobileHeaderState, { passive: true });
    window.addEventListener('pageshow', updateMobileHeaderState);
  })();
</script>
