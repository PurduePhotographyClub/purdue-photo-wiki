---
const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
---

<nav class="grid gap-px border border-white/10 bg-white/10 sm:grid-cols-2" dir={dir} aria-label="Page navigation">
  {prev ? (
    <a href={prev.href} rel="prev" class="group flex min-h-28 items-center gap-4 bg-neutral-950 p-5 text-left no-underline transition hover:bg-white/[0.04] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200">
      <span aria-hidden="true" class="text-xl text-neutral-500 transition group-hover:-translate-x-1 group-hover:text-amber-200">←</span>
      <span>
        <span class="block text-[0.58rem] tracking-[0.18em] text-neutral-400 uppercase">Previous</span>
        <span class="mt-2 block font-['Playfair_Display',Georgia,serif] text-xl leading-tight text-white">{prev.label}</span>
      </span>
    </a>
  ) : <span class="hidden sm:block"></span>}
  {next && (
    <a href={next.href} rel="next" class="group flex min-h-28 items-center justify-end gap-4 bg-neutral-950 p-5 text-right no-underline transition hover:bg-white/[0.04] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200">
      <span>
        <span class="block text-[0.58rem] tracking-[0.18em] text-neutral-400 uppercase">Next</span>
        <span class="mt-2 block font-['Playfair_Display',Georgia,serif] text-xl leading-tight text-white">{next.label}</span>
      </span>
      <span aria-hidden="true" class="text-xl text-neutral-500 transition group-hover:translate-x-1 group-hover:text-amber-200">→</span>
    </a>
  )}
</nav>
