---
type Tone = 'neutral' | 'amber' | 'sky' | 'emerald' | 'violet' | 'rose' | 'discord';
type DiagramType = 'platform' | 'request' | 'media' | 'discord' | 'receipt' | 'scheduler' | 'deployment';

interface DiagramNode {
  detail: string;
  icon?: string;
  label: string;
  tone: Tone;
}

interface DiagramLane {
  label: string;
  nodes: DiagramNode[];
}

interface Diagram {
  caption: string;
  description: string;
  lanes: DiagramLane[];
  title: string;
}

interface Props {
  type: DiagramType;
}

const diagrams: Record<DiagramType, Diagram> = {
  platform: {
    title: 'The complete platform map',
    description: 'The browser reaches the Website Worker, which calls the API Worker. The API owns D1 and R2 and dispatches signed Discord work. Email and scheduled jobs also enter through the API. The wiki deploys separately.',
    caption: 'The API is the center of the operational system. Other services either present it, feed it, or carry out side effects for it.',
    lanes: [
      { label: 'Member request', nodes: [
        { label: 'Browser', detail: 'Pages, forms, dashboard', tone: 'sky' },
        { label: 'Website Worker', detail: 'Astro + React, same-origin bridge', icon: 'astro', tone: 'violet' },
        { label: 'API Worker', detail: 'Rules, auth, routing', icon: 'cloudflareworkers', tone: 'amber' },
        { label: 'D1 + R2', detail: 'Records and media objects', icon: 'cloudflare', tone: 'emerald' },
      ] },
      { label: 'Discord side effect', nodes: [
        { label: 'API Worker', detail: 'Signs a typed internal event', icon: 'cloudflareworkers', tone: 'amber' },
        { label: 'Discord Worker', detail: 'Verifies, claims nonce, dispatches', icon: 'discord', tone: 'discord' },
        { label: 'Discord REST', detail: 'Roles, DMs, posts, channels', icon: 'discord', tone: 'discord' },
      ] },
      { label: 'Receipt intake', nodes: [
        { label: 'Email Routing', detail: 'Forwards a purchase receipt', icon: 'cloudflare', tone: 'sky' },
        { label: 'Email Worker', detail: 'Parses, dedupes, retries', icon: 'cloudflareworkers', tone: 'rose' },
        { label: 'API Worker', detail: 'Claims fulfillment and applies it', icon: 'cloudflareworkers', tone: 'amber' },
      ] },
      { label: 'Scheduled work', nodes: [
        { label: 'Cron', detail: 'Every thirty minutes', icon: 'cloudflare', tone: 'neutral' },
        { label: 'Scheduler Worker', detail: 'Starts six API jobs in parallel', icon: 'cloudflareworkers', tone: 'sky' },
        { label: 'API Worker', detail: 'Leases and runs domain logic', icon: 'cloudflareworkers', tone: 'amber' },
      ] },
      { label: 'Knowledge base', nodes: [
        { label: 'GitHub Actions', detail: 'Builds the Starlight project', icon: 'githubactions', tone: 'sky' },
        { label: 'Cloudflare Pages', detail: 'Hosts static wiki output', icon: 'cloudflarepages', tone: 'amber' },
        { label: 'Reader', detail: 'No API dependency required', tone: 'neutral' },
      ] },
    ],
  },
  request: {
    title: 'A request from click to database',
    description: 'A same-origin browser request crosses the website bridge, receives an internal token and reconstructed proxy context, passes API authentication and authorization, reaches a domain handler, and returns through the same path.',
    caption: 'Ordinary endpoints are exposed to the browser as /api/v1. Better Auth keeps its own /api/auth routes, so the bridge does not rewrite those paths.',
    lanes: [
      { label: 'Request path', nodes: [
        { label: '1 · Browser', detail: 'Fetch /api/v1/... with cookies', tone: 'sky' },
        { label: '2 · Website bridge', detail: 'Strip spoofable headers', icon: 'astro', tone: 'violet' },
        { label: '3 · Service binding', detail: 'Add internal token and proxy context', icon: 'cloudflareworkers', tone: 'amber' },
        { label: '4 · API pipeline', detail: 'Route, session, suspension, rate limits', icon: 'cloudflareworkers', tone: 'amber' },
        { label: '5 · Domain handler', detail: 'Validate and apply business rules', tone: 'emerald' },
        { label: '6 · D1 / R2', detail: 'Read or commit data', icon: 'cloudflare', tone: 'emerald' },
        { label: '7 · Response', detail: 'Status, envelope, browser UI', tone: 'sky' },
      ] },
    ],
  },
  media: {
    title: 'Gallery and competition media lifecycle',
    description: 'The caller submits a full image and thumbnail. The API bounds both files, writes them to R2, records their relationship in D1, and compensates if these database inserts fail.',
    caption: 'Gallery and competition reads use opaque record IDs. Other media routes differ: merchandise exposes its stored key, and leadership creation does not currently have the same insert-failure cleanup.',
    lanes: [
      { label: 'Paired upload', nodes: [
        { label: 'Permission', detail: 'Membership or staff gate', tone: 'amber' },
        { label: 'Submitted pair', detail: 'Full image plus caller-made thumbnail', tone: 'violet' },
        { label: 'Multipart bounds', detail: 'Type, byte, and dimension checks', tone: 'rose' },
        { label: 'R2 objects', detail: 'Store both accepted files', icon: 'cloudflare', tone: 'emerald' },
        { label: 'D1 record', detail: 'Opaque relationship committed', icon: 'cloudflare', tone: 'sky' },
      ] },
      { label: 'Gallery / competition compensation', nodes: [
        { label: 'D1 write fails', detail: 'The record never becomes visible', tone: 'rose' },
        { label: 'Delete new objects', detail: 'Both R2 keys are removed', icon: 'cloudflare', tone: 'amber' },
        { label: 'Return error', detail: 'No orphaned successful upload', tone: 'neutral' },
      ] },
      { label: 'Public read', nodes: [
        { label: 'Opaque record ID', detail: 'Gallery or competition route', tone: 'sky' },
        { label: 'D1 lookup', detail: 'Resolve the permitted object key', icon: 'cloudflare', tone: 'amber' },
        { label: 'R2 stream', detail: 'Return the image bytes', icon: 'cloudflare', tone: 'emerald' },
      ] },
      { label: 'Other media domains', nodes: [
        { label: 'Avatar / event', detail: 'Separate single-object flows', tone: 'neutral' },
        { label: 'Merchandise', detail: 'Public route contains imageR2Key', tone: 'rose' },
        { label: 'Leadership', detail: 'No equivalent insert compensation yet', tone: 'amber' },
      ] },
    ],
  },
  discord: {
    title: 'Discord has three inbound lanes',
    description: 'Interactions, API events, and Gateway events arrive differently. They converge only after the Discord Worker has verified the message and, for internal events, claimed its nonce.',
    caption: 'The VPS Gateway is deliberately narrow. It owns the long-lived websocket; the Worker owns verification, typed dispatch, and Discord side effects.',
    lanes: [
      { label: 'Slash commands', nodes: [
        { label: 'Discord interaction', detail: 'Exact raw request body', icon: 'discord', tone: 'discord' },
        { label: 'Ed25519 check', detail: 'Reject invalid signatures', tone: 'rose' },
        { label: 'Command handler', detail: 'Call API binding when data is needed', tone: 'sky' },
        { label: 'Discord REST', detail: 'Send the response or side effect', icon: 'discord', tone: 'discord' },
      ] },
      { label: 'API event', nodes: [
        { label: 'API Worker', detail: 'Timestamp + HMAC + nonce', icon: 'cloudflareworkers', tone: 'amber' },
        { label: 'Discord Worker', detail: 'Verify signature and age', icon: 'discord', tone: 'discord' },
        { label: 'D1 nonce claim', detail: 'Stop replayed events', icon: 'cloudflare', tone: 'rose' },
        { label: 'Typed dispatcher', detail: 'Run the named domain service', tone: 'emerald' },
      ] },
      { label: 'Gateway event', nodes: [
        { label: 'Discord websocket', detail: 'Members, messages, reactions', icon: 'discord', tone: 'discord' },
        { label: 'VPS Gateway', detail: 'Allowlist, filter, sanitize', icon: 'nodedotjs', tone: 'emerald' },
        { label: 'Signed forward', detail: 'HMAC, timestamp, nonce', tone: 'amber' },
        { label: 'Worker dispatcher', detail: 'Verify, claim, handle', icon: 'cloudflareworkers', tone: 'sky' },
      ] },
      { label: 'Reverse control', nodes: [
        { label: 'Discord Worker', detail: 'Presence change request', icon: 'cloudflareworkers', tone: 'sky' },
        { label: 'VPC service', detail: 'Private route to /presence', icon: 'cloudflare', tone: 'amber' },
        { label: 'VPS Gateway', detail: 'Verify HMAC and update discord.js', icon: 'nodedotjs', tone: 'emerald' },
      ] },
    ],
  },
  receipt: {
    title: 'A receipt reaches fulfillment without duplicate side effects',
    description: 'The Email Worker controls intake and retries. D1 owns the fulfillment, while stable Resend and Discord identifiers cover retries around external calls.',
    caption: 'KV protects intake, D1 owns the business result, and deterministic provider identifiers close the response-loss window.',
    lanes: [
      { label: 'Parse and claim', nodes: [
        { label: 'Email Routing', detail: 'Purchase receipt arrives', icon: 'cloudflare', tone: 'sky' },
        { label: 'Ingress checks', detail: 'Recipient, sender, raw-size limit', tone: 'rose' },
        { label: 'postal-mime', detail: 'Decode message and attachments', tone: 'violet' },
        { label: 'unpdf', detail: 'Extract receipt PDF text', tone: 'violet' },
        { label: 'TooCOOL parser', detail: 'Read order and line items', tone: 'amber' },
        { label: 'KV lease', detail: 'Dedupe the intake attempt', icon: 'cloudflare', tone: 'sky' },
        { label: 'D1 claim', detail: 'Claim fulfillment idempotency key', icon: 'cloudflare', tone: 'emerald' },
      ] },
      { label: 'Fulfillment', nodes: [
        { label: 'Membership', detail: 'Create activation key', tone: 'emerald' },
        { label: 'Resend', detail: 'Stable Idempotency-Key', icon: 'resend', tone: 'neutral' },
        { label: 'Discord event', detail: 'Deterministic message nonce', icon: 'discord', tone: 'discord' },
      ] },
      { label: 'Other purchase', nodes: [
        { label: 'Film or print', detail: 'Recognize item type', tone: 'amber' },
        { label: 'Discord event', detail: 'Notify club operators', icon: 'discord', tone: 'discord' },
      ] },
      { label: 'Failure', nodes: [
        { label: 'Temporary', detail: 'Store retry record in KV', tone: 'sky' },
        { label: 'Five-minute cron', detail: 'Try the intake again', icon: 'cloudflare', tone: 'amber' },
        { label: 'Permanent normalized payload', detail: 'Record and stop looping', tone: 'rose' },
      ] },
    ],
  },
  scheduler: {
    title: 'The scheduler owns time, not business logic',
    description: 'Every thirty minutes the Scheduler Worker starts six private API jobs in parallel. The API claims a D1 lease and decides what each job changes.',
    caption: 'A repeated cron delivery is safe because the API owns the lease. Anything visible in Discord still goes through a signed internal event.',
    lanes: [
      { label: 'Trigger', nodes: [
        { label: 'Cloudflare Cron', detail: '*/30 * * * *', icon: 'cloudflare', tone: 'sky' },
        { label: 'Scheduler Worker', detail: 'Build six POST requests', icon: 'cloudflareworkers', tone: 'amber' },
        { label: 'Internal auth', detail: 'Source, token, scheduled time', tone: 'rose' },
        { label: 'D1 lease', detail: 'One active run per job', icon: 'cloudflare', tone: 'emerald' },
        { label: 'Domain logic', detail: 'API performs the actual work', icon: 'cloudflareworkers', tone: 'amber' },
      ] },
      { label: 'Six jobs', nodes: [
        { label: 'Memberships', detail: 'Expire elapsed access', tone: 'neutral' },
        { label: 'Darkroom', detail: 'Schedule sweep + stats sync', tone: 'neutral' },
        { label: 'Studio', detail: 'Schedule sweep', tone: 'neutral' },
        { label: 'Equipment', detail: 'Send reminder work', tone: 'neutral' },
        { label: 'Photographers', detail: 'Expire old requests', tone: 'neutral' },
      ] },
    ],
  },
  deployment: {
    title: 'Code moves through separate deployment lanes',
    description: 'Each repository verifies itself before deployment. Most services deploy from main to Cloudflare. The VPS Gateway follows a separate Git and systemd path.',
    caption: 'The API migration runs before its Worker deploy. A bootstrap config can omit the Discord binding when the bot Worker does not exist yet.',
    lanes: [
      { label: 'Cloudflare Workers', nodes: [
        { label: 'Push to main', detail: 'Website, API, Discord, email, scheduler', icon: 'githubactions', tone: 'sky' },
        { label: 'Configured checks', detail: 'Types and build; tests where included', tone: 'emerald' },
        { label: 'Deploy', detail: 'Wrangler publishes the Worker', icon: 'cloudflareworkers', tone: 'amber' },
        { label: 'Observability', detail: '10% head sampling enabled', icon: 'cloudflare', tone: 'neutral' },
      ] },
      { label: 'API special case', nodes: [
        { label: 'D1 migrations', detail: 'Apply schema changes first', icon: 'cloudflare', tone: 'emerald' },
        { label: 'Bootstrap check', detail: 'Omit bot binding when necessary', tone: 'rose' },
        { label: 'API deploy', detail: 'Publish current router and handlers', icon: 'cloudflareworkers', tone: 'amber' },
      ] },
      { label: 'Wiki', nodes: [
        { label: 'Push to main', detail: 'Static Astro project', icon: 'githubactions', tone: 'sky' },
        { label: 'Build + Pagefind', detail: 'Generate HTML and search index', icon: 'astro', tone: 'violet' },
        { label: 'Cloudflare Pages', detail: 'Publish dist', icon: 'cloudflarepages', tone: 'amber' },
      ] },
      { label: 'VPS Gateway', nodes: [
        { label: 'Local preparation', detail: 'Build Gateway and package dist', icon: 'nodedotjs', tone: 'emerald' },
        { label: 'Push deploy repo', detail: 'Send prebuilt artifact to bare Git', tone: 'sky' },
        { label: 'Post-receive hook', detail: 'Checkout and install production deps', tone: 'amber' },
        { label: 'systemd restart', detail: 'Replace the live process', tone: 'rose' },
      ] },
    ],
  },
};

const toneClasses: Record<Tone, string> = {
  neutral: 'border-neutral-700 bg-neutral-900/60 text-neutral-100',
  amber: 'border-amber-300/40 bg-amber-300/[0.06] text-amber-100',
  sky: 'border-sky-300/40 bg-sky-300/[0.06] text-sky-100',
  emerald: 'border-emerald-300/40 bg-emerald-300/[0.06] text-emerald-100',
  violet: 'border-violet-300/40 bg-violet-300/[0.06] text-violet-100',
  rose: 'border-rose-300/40 bg-rose-300/[0.06] text-rose-100',
  discord: 'border-[#5865f2]/50 bg-[#5865f2]/10 text-indigo-100',
};

const { type } = Astro.props;
const diagram = diagrams[type];
const diagramId = `system-diagram-${type}`;
---

<figure aria-labelledby={`${diagramId}-title ${diagramId}-description`} class="my-10 overflow-hidden border border-white/10 bg-neutral-950">
  <div class="border-b border-white/10 bg-white/[0.025] p-5 sm:p-6">
    <p class="m-0 text-[0.58rem] tracking-[0.2em] text-amber-200 uppercase">System diagram</p>
    <h2 id={`${diagramId}-title`} class="mt-2! border-0! pt-0! text-3xl!">{diagram.title}</h2>
    <p id={`${diagramId}-description`} class="mt-3 mb-0 max-w-3xl text-sm leading-6 text-neutral-400">{diagram.description}</p>
  </div>

  <div class="space-y-px bg-white/10">
    {diagram.lanes.map((lane) => (
      <section class="bg-neutral-950 p-4 sm:p-6" aria-label={lane.label}>
        <p class="mb-3 text-[0.58rem] font-bold tracking-[0.18em] text-neutral-400 uppercase">{lane.label}</p>
        <div class:list={['flex flex-col items-stretch gap-2', lane.nodes.length <= 4 && 'xl:flex-row xl:items-center']}>
          {lane.nodes.map((node, index) => (
            <>
              <div class:list={['flex min-h-28 min-w-0 flex-1 items-start gap-3 border p-4', toneClasses[node.tone]]}>
                {node.icon ? (
                  <span class="grid size-9 shrink-0 place-items-center border border-current/15 bg-black/20">
                    <img data-no-expand src={`/images/tech/${node.icon}.svg`} width="20" height="20" alt="" loading="lazy" decoding="async" class="size-5 object-contain" />
                  </span>
                ) : (
                  <span class="grid size-9 shrink-0 place-items-center border border-current/20 text-[0.58rem] font-bold">{String(index + 1).padStart(2, '0')}</span>
                )}
                <span>
                  <strong class="block text-xs leading-5 text-current">{node.label}</strong>
                  <span class="mt-1 block text-[0.66rem] leading-5 text-neutral-400">{node.detail}</span>
                </span>
              </div>
              {index < lane.nodes.length - 1 && (
                <span aria-hidden="true" class:list={['self-center text-lg text-neutral-600', lane.nodes.length <= 4 && 'xl:px-1']}>
                  <span class:list={[lane.nodes.length <= 4 && 'xl:hidden']}>↓</span>
                  <span class:list={['hidden', lane.nodes.length <= 4 && 'xl:inline']}>→</span>
                </span>
              )}
            </>
          ))}
        </div>
      </section>
    ))}
  </div>

  <figcaption class="border-t border-white/10 bg-white/[0.025] px-5 py-4 text-xs leading-5 text-neutral-400 sm:px-6">
    {diagram.caption}
  </figcaption>
</figure>
