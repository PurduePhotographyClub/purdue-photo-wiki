---
const route = Astro.locals.starlightRoute;
const data = route.entry.data as typeof route.entry.data & {
  author?: string;
  date?: Date | string;
  accent?: 'silver' | 'slate' | 'amber' | 'orange' | 'yellow' | 'lime' | 'green' | 'emerald' | 'teal' | 'cyan' | 'sky' | 'blue' | 'indigo' | 'violet' | 'purple' | 'fuchsia' | 'pink' | 'rose' | 'red';
};

const { title, description, author, date, accent = 'silver' } = data;
const sectionLabels: Record<string, string> = {
  index: 'Purdue Photography Club',
  photography: 'Photography guides',
  system: 'Club system guide',
  '404': 'Page not found',
};
const section = route.id.split('/')[0] || 'index';
const kicker = sectionLabels[section] ?? section.replaceAll('-', ' ');
const formattedDate = date
  ? new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(new Date(date))
  : '';

const accentClasses: Record<string, { text: string; line: string; wash: string }> = {
  silver: { text: 'text-neutral-300', line: 'bg-neutral-300/60', wash: 'from-neutral-300/10' },
  slate: { text: 'text-slate-300', line: 'bg-slate-300/60', wash: 'from-slate-300/10' },
  amber: { text: 'text-amber-200', line: 'bg-amber-200/70', wash: 'from-amber-300/10' },
  orange: { text: 'text-orange-200', line: 'bg-orange-200/70', wash: 'from-orange-300/10' },
  yellow: { text: 'text-yellow-200', line: 'bg-yellow-200/70', wash: 'from-yellow-300/10' },
  lime: { text: 'text-lime-200', line: 'bg-lime-200/70', wash: 'from-lime-300/10' },
  green: { text: 'text-green-200', line: 'bg-green-200/70', wash: 'from-green-300/10' },
  emerald: { text: 'text-emerald-200', line: 'bg-emerald-200/70', wash: 'from-emerald-300/10' },
  teal: { text: 'text-teal-200', line: 'bg-teal-200/70', wash: 'from-teal-300/10' },
  cyan: { text: 'text-cyan-200', line: 'bg-cyan-200/70', wash: 'from-cyan-300/10' },
  sky: { text: 'text-sky-200', line: 'bg-sky-200/70', wash: 'from-sky-300/10' },
  blue: { text: 'text-blue-200', line: 'bg-blue-200/70', wash: 'from-blue-300/10' },
  indigo: { text: 'text-indigo-200', line: 'bg-indigo-200/70', wash: 'from-indigo-300/10' },
  violet: { text: 'text-violet-200', line: 'bg-violet-200/70', wash: 'from-violet-300/10' },
  purple: { text: 'text-purple-200', line: 'bg-purple-200/70', wash: 'from-purple-300/10' },
  fuchsia: { text: 'text-fuchsia-200', line: 'bg-fuchsia-200/70', wash: 'from-fuchsia-300/10' },
  pink: { text: 'text-pink-200', line: 'bg-pink-200/70', wash: 'from-pink-300/10' },
  rose: { text: 'text-rose-200', line: 'bg-rose-200/70', wash: 'from-rose-300/10' },
  red: { text: 'text-red-200', line: 'bg-red-200/70', wash: 'from-red-300/10' },
};
const accentStyle = accentClasses[accent] ?? accentClasses.silver;
---

{route.id !== '404' && (
  <header class:list={['relative mb-8 overflow-hidden border-y border-white/10 bg-gradient-to-r to-transparent px-4 py-7 sm:px-7 sm:py-8 lg:px-10 xl:px-12', accentStyle.wash]}>
    <div class:list={['mb-3 flex items-center gap-3 text-[0.62rem] tracking-[0.2em] uppercase', accentStyle.text]}>
      <span class:list={['h-px w-9', accentStyle.line]}></span>
      {kicker}
    </div>
    <h1 id="_top" class="m-0 max-w-[18ch] scroll-mt-24 font-['Playfair_Display',Georgia,serif] text-4xl leading-[0.98] font-black tracking-tight text-balance text-white sm:text-5xl lg:text-6xl">
      {title}
    </h1>
    {description && <p class="mt-4 max-w-[65ch] text-sm leading-7 text-neutral-300 sm:text-[0.95rem]">{description}</p>}
    {(author || formattedDate) && (
      <div class="mt-5 flex flex-wrap items-center gap-3 text-[0.65rem] tracking-[0.14em] text-neutral-300 uppercase" aria-label="Page details">
        {author && <span>{author}</span>}
        {author && formattedDate && <span aria-hidden="true" class:list={['h-px w-7', accentStyle.line]}></span>}
        {formattedDate && <time datetime={new Date(date as Date | string).toISOString()}>{formattedDate}</time>}
      </div>
    )}
  </header>
)}
