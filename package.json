{
  "name": "purdue-photography-club-wiki",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm test && npm run build",
    "preview": "astro preview",
    "pages:preview": "npm run build && wrangler pages dev dist",
    "pages:deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.5",
    "astro": "^7.3.5",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "devalue": "5.9.4",
    "http-cache-semantics": "4.3.0",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "7.1.6",
    "unifont": {
      "undici": "8.11.2"
    }
  }
}
